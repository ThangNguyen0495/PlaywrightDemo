{
  "name": "playwright-framework-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "projects/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.workspace.json",
    "decrypt:secret": "node scripts/decrypt-secret.mjs",
    "generate:key": "node scripts/generate-secret-key.mjs",
    "test:orangehrm": "cross-env env=qat playwright test -c playwright.config.ts",

    "test:orangehrm:headed": "cross-env env=qat playwright test -c playwright.config.ts --headed",
    "test:all": "npm run test --workspaces --if-present",
    "encrypt:secret": "node scripts/encrypt-secret.mjs",
    "typecheck": "tsc -b tsconfig.workspace.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.3.1",
    "typescript": "^5.2.2"
  }
}
